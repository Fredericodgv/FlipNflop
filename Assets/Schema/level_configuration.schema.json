{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://JEDCIRCUITOS/Assets/Schema/level_configuration.schema.json",
    "title": "Esquema de Nível de Jogo",
    "description": "Define a estrutura de um arquivo JSON de configuração de nível.",
    "type": "object",
    "properties": {
        "levelName": {
            "type": "string",
            "description": "O nome descritivo do nível (formato: 'level_n')."
        },
        "levelDescription": {
            "type": "string",
            "description": "Descrição detalhada do nível."
        },
        "levelID": {
            "type": "integer",
            "description": "ID para identificação de ordenação de fases."
        },
        "clockCicles": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantidade de ciclos de clock na fase."
        },
        "activeClockEdge": {
            "type": "string",
            "enum": ["rising", "falling"],
            "description": "Define se o sinal responde à borda de subida ou descida."
        },
        "j_signal": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para o J (sequência de 1s e 0s)."
        },
        "k_signal": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para o K (sequência de 1s e 0s)."
        },
        "asyncActive": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Define se sinais assíncronos estão ativos (1) ou inativos (0)."
        },
        "jSignalColor": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "kSignalColor": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "presetSignalColor": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "clearSignalColor": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "clockSignalColor": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "floor": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Representação binária do chão"
        },
        "ceiling": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Representação binária do teto"
        },
        "obstacle": {
            "type": "array",
            "description": "Lista de configurações para geração de diferentes obstáculos.",
            "items": {
                "type": "object",
                "properties": {
                    "obstacleName": {
                        "type": "string",
                        "description": "Nome/ID do obstáculo a ser gerado.",
                        "enum": [
                            "Rock",
                            "Button",
                            "Wall",
                            "SpikeTrap",
                            "MovingPlatform"
                        ]
                    },
                    "quantity": { "type": "integer", "const": 1 },
                    "startX": { "type": "number" },
                    "startY": { "type": "number" },
                    "speed": { "type": "number"},
                    "horizontalDistance": { "type": "number" },
                    "verticalDistance": { "type": "number" },
                    "starterCorner": { "type": "string" },
                    "clockwise": { "type": "boolean" }
                },
                "required": [
                    "obstacleName",
                    "quantity",
                    "startX",
                    "startY"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "levelName",
        "clockCicles",
        "j_signal",
        "k_signal",
        "assyncActive",
        "floor",
        "ceiling",
        "obstacle"
    ],
    "if": {
        "properties": { "assyncActive": { "const": 1 } }
    },
    "then": {
        "required": [ "presetSignal", "clearSignal" ],
        "properties": {
            "presetSignal": { "type": "string", "pattern": "^[01 ]+$" },
            "clearSignal": { "type": "string", "pattern": "^[01 ]+$" }
        }
    },
    "else": {
        "properties": {
            "presetSignal": { "type": "null"},
            "clearSignal": { "type": "null"}
        }
    },
    "additionalProperties": false
}
