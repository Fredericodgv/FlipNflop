  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: bcdba3d027686d241b4c3261971aa0ab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 682767581184
    m_Localized: "Use a Barra de Espa\xE7o para pular. O pulo permite tirar temporariamente
      a personagem da plataforma para transpor os obst\xE1culos presentes no caminho,
      sem alterar o n\xEDvel l\xF3gico da linha sendo desenhada."
    m_Metadata:
      m_Items: []
  - m_Id: 698110345216
    m_Localized: "Pressione a tecla Shift para arrancar. Essa a\xE7\xE3o permite
      impulsionar rapidamente o movimento da personagem (dash), conferindo agilidade
      e facilitando a supera\xE7\xE3o dos obst\xE1culos no cen\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 650081370112
    m_Localized: "Use as teclas A e D (ou setas \u2190 e \u2192) para controlar a
      personagem. O deslocamento para a direita representa o avan\xE7o do tempo no
      contexto do diagrama, desenhando gradualmente a linha da sa\xEDda de acordo
      com o caminho percorrido. O deslocamento para a esquerda representa o retrocesso
      no tempo, permitindo apagar a linha de sa\xEDda desenhada para corrigir eventuais
      erros no diagrama."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
