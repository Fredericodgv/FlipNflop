  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: bcdba3d027686d241b4c3261971aa0ab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 682767581184
    m_Localized: "Use Espa\xE7o para pular. Permite desviar de obst\xE1culos no ch\xE3o
      sem alterar o n\xEDvel l\xF3gico da linha desenhada."
    m_Metadata:
      m_Items: []
  - m_Id: 698110345216
    m_Localized: "Use Shift para arrancar (dash). Um impulso r\xE1pido que garante
      agilidade para ultrapassar pedras e perigos."
    m_Metadata:
      m_Items: []
  - m_Id: 650081370112
    m_Localized: "Use A/D ou as setas para esquerda/direita para movimentar horizontalmente
      a personagem. Ao andar para a direita, a linha do sinal de sa\xEDda \xE9 desenhada.
      Ao andar para a esquerda, a linha \xE9 apagada (permitindo corrigir erros)."
    m_Metadata:
      m_Items: []
  - m_Id: 596200044527616
    m_Localized: "O seu objetivo \xE9 construir corretamente o diagrama de tempo
      para o sinal de sa\xEDda do circuito. Analise os sinais de entrada e as transi\xE7\xF5es
      do clock para guiar a personagem, desenhando a linha de sa\xEDda adequada ao
      alternar entre as plataformas que representam os n\xEDveis l\xF3gicos 0 e 1."
    m_Metadata:
      m_Items: []
  - m_Id: 29643145500
    m_Localized: "Use W ou a seta para cima para alternar entre as plataformas do
      piso e do teto, trocando o n\xEDvel l\xF3gico do sinal de sa\xEDda entre 0
      e 1."
    m_Metadata:
      m_Items: []
  - m_Id: 119405445200
    m_Localized: "Use H para habilitar/desabilitar as linhas de ajuda para eventos
      s\xEDncronos e ass\xEDncronos."
    m_Metadata:
      m_Items: []
  - m_Id: 29643145600
    m_Localized: "Ao final da fase, verifique os acertos e erros no diagrama desenhado
      e a pontua\xE7\xE3o obtida."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
