:root {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
}

/* ── HUD Signal Labels ── */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    /* No pointer events on the root so it doesn't block gameplay input */
    pointer-events: none;
}

.signal-label {
    position: absolute;
    align-items: center;
    justify-content: center;
    /* Hidden by default; script shows them when needed */
    display: none;
}

.signal-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.signal-text-wrapper {
    align-items: stretch;
    justify-content: center;
    flex-direction: column;
}

.signal-overline {
    height: 2px;
    background-color: white;
    margin-bottom: 1px;
    display: none;
}

.signal-overline.active {
    display: flex;
}

.signal-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 24px;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}
