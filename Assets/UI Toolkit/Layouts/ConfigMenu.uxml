<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ConfigContainer" class="config-container">
        <ui:VisualElement name="Header" class="config-header">
            <ui:Label text="Configurações" name="TitleConfig" class="menu-title config-title"/>
        </ui:VisualElement>

        <ui:VisualElement name="TabsArea" class="config-tabs">
            <ui:Button text="Cores" name="BtnTabColors" class="menu-button config-tab-button"/>
            <ui:Button text="Áudio" name="BtnTabAudio" class="menu-button config-tab-button"/>
            <ui:Button text="Vídeo" name="BtnTabVideo" class="menu-button config-tab-button"/>
            <ui:Button text="Controles" name="BtnTabControls" class="menu-button config-tab-button"/>
        </ui:VisualElement>

        <ui:VisualElement name="PagesArea" class="config-pages">
            <ui:VisualElement name="PanelColor" class="config-page config-color-page" style="display: flex;">
                <ui:Label text="Personalização dos Sinais" class="config-section-title"/>

                <ui:VisualElement class="config-palette-row">
                    <ui:Label text="Paleta:" class="config-inline-label"/>
                    <ui:DropdownField name="DropdownPaleta" class="config-palette-dropdown"/>
                </ui:VisualElement>

                <ui:ScrollView name="ColorScrollView" class="config-color-scroll">
                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="J" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewJ" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesJ" class="config-swatches"/>
                        <ui:Button name="BtnCustomJ" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="K" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewK" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesK" class="config-swatches"/>
                        <ui:Button name="BtnCustomK" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="Preset" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewPreset" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesPreset" class="config-swatches"/>
                        <ui:Button name="BtnCustomPreset" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="Clear" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewClear" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesClear" class="config-swatches"/>
                        <ui:Button name="BtnCustomClear" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="CLK" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewCLK" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesCLK" class="config-swatches"/>
                        <ui:Button name="BtnCustomCLK" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:Label text="Feedback do Desenho" class="config-subsection-title"/>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="Certo" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewFeedbackSuccess" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesFeedbackSuccess" class="config-swatches"/>
                        <ui:Button name="BtnCustomFeedbackSuccess" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="config-color-row">
                        <ui:Label text="Errado" class="config-signal-label"/>
                        <ui:VisualElement name="PreviewFeedbackFailure" class="config-color-preview"/>
                        <ui:VisualElement name="ContainerSwatchesFeedbackFailure" class="config-swatches"/>
                        <ui:Button name="BtnCustomFeedbackFailure" text="+" class="menu-button config-plus-button"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="PanelAudio" class="config-page config-audio-page" style="display: none;">
                <ui:Label text="Volume Geral" class="config-field-label"/>
                <ui:Slider name="SliderMaster" high-value="1" low-value="0" class="config-slider"/>
                <ui:Label text="Efeitos Sonoros" class="config-field-label"/>
                <ui:Slider name="SliderSons" high-value="1" low-value="0" class="config-slider"/>
                <ui:Label text="Música" class="config-field-label"/>
                <ui:Slider name="SliderMusica" high-value="1" low-value="0" class="config-slider"/>
                <ui:Button name="BtnResetAudio" text="Restaurar Padrões" class="menu-button" style="align-self: center; margin-top: 10px;"/>
            </ui:VisualElement>

            <ui:VisualElement name="PanelVideo" class="config-page config-video-page" style="display: none;">
                <ui:Label text="Contraste do Fundo" class="config-section-title"/>
                <ui:Slider name="SliderContrast" high-value="1" low-value="-1" class="config-slider"/>
                <ui:VisualElement class="config-actions-row">
                    <ui:Button name="BtnResetContrast" text="Resetar Contraste" class="menu-button config-action-button"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="PanelControls" class="config-page config-controls-page" style="display: none;">
                <!-- <ui:Label text="Mapeamento de Teclas" class="config-section-title"/> -->
                <ui:ScrollView name="ControlsScrollView" class="config-controls-scroll"/>
                <ui:Button name="BtnRestoreControls" text="Restaurar Padrões" class="menu-button config-restore-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="RGBOverlay" class="config-rgb-overlay" style="display: none;">
            <ui:VisualElement class="config-rgb-dialog">
                <ui:Label text="Cor Personalizada" name="RGBTitle" class="config-section-title"/>
                <ui:VisualElement name="RGBPreview" class="config-rgb-preview"/>
                <ui:Label text="HEX" class="config-field-label"/>
                <ui:TextField name="InputHex" class="config-hex-input"/>
                <ui:Label text="R" class="config-field-label"/>
                <ui:Slider name="SliderR" low-value="0" high-value="255" class="config-slider"/>
                <ui:Label text="G" class="config-field-label"/>
                <ui:Slider name="SliderG" low-value="0" high-value="255" class="config-slider"/>
                <ui:Label text="B" class="config-field-label"/>
                <ui:Slider name="SliderB" low-value="0" high-value="255" class="config-slider"/>
                <ui:VisualElement class="config-actions-row">
                    <ui:Button text="Cancelar" name="BtnCancelRGB" class="menu-button config-action-button"/>
                    <ui:Button text="Confirmar" name="BtnConfirmRGB" class="menu-button config-action-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
