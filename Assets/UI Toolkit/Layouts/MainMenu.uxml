<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">
    <ui:Template name="HowToPlayMenu"
        src="project://database/Assets/UI%20Toolkit/Layouts/HowToPlayMenu.uxml?fileID=9197481963319205126&amp;guid=bc0db67d26e0fe54f90c3c6cc9e71f26&amp;type=3#HowToPlayMenu" />
    <ui:Template name="ConfigMenu"
        src="project://database/Assets/UI%20Toolkit/Layouts/ConfigMenu.uxml?fileID=9197481963319205126&amp;guid=c9199edad8332b34db99cecc978a6c8d&amp;type=3#ConfigMenu" />
    <Style
        src="project://database/Assets/UI%20Toolkit/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=914addff2ff73d644a3f7eeeebd54bb4&amp;type=3#MainMenu" />
    <Style
        src="project://database/Assets/UI%20Toolkit/Styles/Panel.uss?fileID=7433441132597879392&amp;guid=5b6ccb061d6f6e54b939846c701d8098&amp;type=3#Panel" />
    <ui:VisualElement class="screen bg-main">
        <ui:VisualElement class="overlay" />
        <ui:VisualElement name="MainMenu" class="panel" style="display: flex;">
            <ui:VisualElement class="card menu-card-small">
                <ui:Button text="Jogar" name="PlayButton" class="btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(308182679552)" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Upload" name="UploadButton" class="btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(350805196800)" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Como Jogar" name="HowToPlayButton" class="btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(497320624128)" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Opções" name="SettingsButton" class="btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(56102938472)" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Créditos" name="AboutButton" class="btn">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(438717808640)" />
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="About" class="panel hidden">
            <ui:VisualElement class="page about-page">
                <ui:Label text="Créditos" name="Title" class="title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(438717808700)" />
                    </Bindings>
                </ui:Label>
                <ui:ScrollView name="CreditsScrollView" mode="Vertical" horizontal-scroller-visibility="Hidden"
                    class="credits">
                    <ui:Label text="Flip n&apos; Flop" name="Subtitle" class="subtitle" />
                    <ui:Label
                        text="Um jogo educacional digital criado para apoiar o aprendizado de diagramas de tempo de flip-flops, combinando lógica digital, desafios interativos e progressão por fases."
                        class="text" style="white-space: normal;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text"
                                table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567890)" />
                        </Bindings>
                    </ui:Label>
                    <ui:VisualElement name="Credits" class="credits-list">
                        <ui:VisualElement class="credit-section">
                            <ui:Label text="Desenvolvedores (Alunos)"
                                style="color: rgb(255, 215, 0); -unity-font-style: bold; font-size: 20px; margin-top: 15px; margin-bottom: 5px;">
                                <Bindings>
                                    <UnityEngine.Localization.LocalizedString property="text"
                                        table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567891)" />
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Diogo Amarante" class="text" />
                            <ui:Label text="Frederico Dôndici" class="text" />
                            <ui:Label text="João Vitor Fernandes" class="text" />
                            <ui:Label text="Pedro Crawford" class="text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="credit-section">
                            <ui:Label text="Artistas voluntários" class="subtitle"
                                style="color: rgb(255, 215, 0); -unity-font-style: bold; font-size: 20px; margin-top: 15px; margin-bottom: 5px;">
                                <Bindings>
                                    <UnityEngine.Localization.LocalizedString property="text"
                                        table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567892)" />
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Diego Ângelo (Arte da Personagem)" class="text">
                                <Bindings>
                                    <UnityEngine.Localization.LocalizedString property="text"
                                        table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567893)" />
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Luis Felipe &quot;Koreano&quot; Resende (Música)" class="text"
                                style="white-space: normal;">
                                <Bindings>
                                    <UnityEngine.Localization.LocalizedString property="text"
                                        table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567894)" />
                                </Bindings>
                            </ui:Label>
                        </ui:VisualElement>
                        <ui:VisualElement class="credit-section">
                            <ui:Label text="Orientadores (Professores)" class="subtitle"
                                style="color: rgb(255, 215, 0); -unity-font-style: bold; font-size: 20px; margin-top: 15px; margin-bottom: 5px;">
                                <Bindings>
                                    <UnityEngine.Localization.LocalizedString property="text"
                                        table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(51234567895)" />
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Luciano Chaves" class="text" />
                            <ui:Label text="Marcelo Caniato" class="text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="LevelSelect" class="panel hidden">
            <ui:VisualElement class="page">
                <ui:Label text="Selecione a fase" name="Title" class="title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text"
                            table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(29643145300)" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement name="LevelGrid" class="grid"
                    style="align-self: center; justify-content: space-between; align-items: stretch; max-width: 501px;">
                    <ui:Button text="1" name="Level1" class="level" />
                    <ui:Button text="2" name="Level2" class="level" />
                    <ui:Button text="3" name="Level3" class="level" />
                    <ui:Button text="4" name="Level4" class="level" />
                    <ui:Button text="5" name="Level5" class="level" />
                    <ui:Button text="6" name="Level6" class="level" />
                    <ui:Button text="7" name="Level7" class="level" />
                    <ui:Button text="8" name="Level8" class="level" />
                    <ui:Button text="9" name="Level9" class="level" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="HowToPlay" class="panel hidden">
            <ui:Instance template="HowToPlayMenu" name="TemplateContainer"
                style="flex-grow: 1; align-items: center; align-self: center; justify-content: center; width: 100%; height: 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="Settings" class="panel hidden">
            <ui:VisualElement class="content-card config-content-card">
                <ui:Instance template="ConfigMenu" name="ConfigTemplateContainer" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Voltar" name="BackButton" class="btn back hidden">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6"
                    entry="Id(29643145216)" />
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>