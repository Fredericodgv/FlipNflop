<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ConfigMenu" src="project://database/Assets/UI%20Toolkit/Layouts/ConfigMenu.uxml?fileID=9197481963319205126&amp;guid=c9199edad8332b34db99cecc978a6c8d&amp;type=3#ConfigMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Panel.uss?fileID=7433441132597879392&amp;guid=5b6ccb061d6f6e54b939846c701d8098&amp;type=3#Panel"/>
    <ui:Button text="Menu" name="MenuButton" style="height: 48px; width: 128px; white-space: nowrap; justify-content: space-around; align-self: flex-end; margin-top: 8px; margin-right: 8px; position: absolute; display: flex; top: -4px; left: 1165px; font-size: 24px;">
        <Bindings>
            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(12584910848)"/>
        </Bindings>
    </ui:Button>
    <ui:VisualElement name="GameMenu" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="Background" style="flex-grow: 1; top: 0; right: 0; bottom: 0; left: 0; background-image: url(&quot;project://database/Assets/Arts/Background.jpeg?fileID=2800000&amp;guid=37bc92238ca852342bb6cdda5efd7029&amp;type=3#Background&quot;); background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement name="PanelMain" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; flex-direction: column; flex-wrap: nowrap; flex-basis: auto; align-items: center; justify-content: center; align-content: flex-start; align-self: auto;">
                <ui:Label text="Menu" name="Menu" class="menu-title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(84920173621)"/>
                    </Bindings>
        </ui:Label>
                <ui:Button text="Continuar" name="Continue" class="menu-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(39482017465)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button text="Recomeçar" name="Retry" class="menu-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(92017465139)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button text="Tutorial" name="TutorialButton" class="menu-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:036ba1f80a47b0447b1a810480fee168" entry="Id(497320624128)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button text="Opções" name="Options" class="menu-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" entry="Id(56102938472)" table="GUID:1335d71b210ede741858eb8a611103b6"/>
                    </Bindings>
                </ui:Button>
                <ui:Button text="Sair" name="Exit" class="menu-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(47382019560)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="PanelOptions" style="flex-grow: 1; display: none;">
                <ui:Instance template="ConfigMenu"/>
            </ui:VisualElement>
            <ui:VisualElement name="Tutorial" style="flex-grow: 1; position: absolute; visibility: visible; top: 1px; right: 1px; bottom: 1px; left: 1px; display: none;">
                <ui:Label text="Como Jogar" name="Title" style="align-items: auto; justify-content: flex-start; align-self: center; font-size: 36px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&amp;guid=06cc052497f62034fb43e3edf087d21a&amp;type=3#Exo2-VariableFont_wght&quot;); color: rgb(255, 255, 255);"/>
                <ui:ScrollView name="ScrollView" style="flex-grow: 1; margin-left: 64px; width: auto; margin-bottom: 128px; background-color: rgba(0, 0, 0, 0.878); margin-right: 64px;">
                    <ui:VisualElement name="Jogo" focusable="false" style="flex-grow: 1; flex-direction: row-reverse; margin-bottom: 20px;">
                        <ui:VisualElement name="Image" style="flex-grow: 1; height: 150px;"/>
