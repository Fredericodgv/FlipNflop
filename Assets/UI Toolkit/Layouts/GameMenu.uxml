                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement name="Jump" style="flex-grow: 1; flex-direction: row-reverse; margin-bottom: 20px;">
                        <ui:VisualElement name="Image" style="flex-grow: 1; height: 150px;"/>
                        <ui:Label name="Text" style="width: 60%; white-space: normal; font-size: 24px; color: rgb(255, 255, 255);">
                            <Bindings>
