<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ConfigMenu" src="project://database/Assets/UI%20Toolkit/Layouts/ConfigMenu.uxml?fileID=9197481963319205126&amp;guid=c9199edad8332b34db99cecc978a6c8d&amp;type=3#ConfigMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Panel.uss?fileID=7433441132597879392&amp;guid=5b6ccb061d6f6e54b939846c701d8098&amp;type=3#Panel"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=914addff2ff73d644a3f7eeeebd54bb4&amp;type=3#MainMenu"/>
    <ui:Button text="Menu" name="MenuButton" class="hud-menu-button">
        <Bindings>
            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(12584910848)"/>
        </Bindings>
    </ui:Button>
    <ui:VisualElement name="GameMenu" class="flip-screen" style="display: none;">
        <ui:VisualElement name="Background" class="flip-screen bg-main">
            <ui:VisualElement class="screen-overlay"/>
            <ui:VisualElement name="PanelMain" class="screen-panel">
                <ui:VisualElement class="menu-card game-menu-card">
                    <ui:Button text="Continuar" name="Continue" class="menu-button action-button">
<!--                        <Bindings>-->
<!--                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(39482017465)"/>-->
<!--                        </Bindings>-->
                    </ui:Button>
                    <ui:Button text="Recomeçar" name="Retry" class="menu-button">
<!--                        <Bindings>-->
<!--                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(92017465139)"/>-->
<!--                        </Bindings>-->
                    </ui:Button>
                    <ui:Button text="Como Jogar" name="TutorialButton" class="menu-button">
<!--                        <Bindings>-->
<!--                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:036ba1f80a47b0447b1a810480fee168" entry="Id(497320624128)"/>-->
<!--                        </Bindings>-->
                    </ui:Button>
                    <ui:Button text="Opções" name="Options" class="menu-button">
<!--                        <Bindings>-->
<!--                            <UnityEngine.Localization.LocalizedString property="text" entry="Id(56102938472)" table="GUID:1335d71b210ede741858eb8a611103b6"/>-->
<!--                        </Bindings>-->
                    </ui:Button>
                    <ui:Button text="Sair" name="Exit" class="menu-button">
<!--                        <Bindings>-->
<!--                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1335d71b210ede741858eb8a611103b6" entry="Id(47382019560)"/>-->
<!--                        </Bindings>-->
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PanelOptions" class="screen-panel hidden">
                <ui:VisualElement class="content-card config-content-card">
                    <ui:Instance template="ConfigMenu"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Tutorial" class="panel hidden">
                <ui:VisualElement class="page tutorial-page">
                    <ui:Label text="Como Jogar" name="Title" class="title"/>
                    <ui:ScrollView name="ScrollView" class="tutorial-scroll">
                        <ui:VisualElement name="Jogo" focusable="false" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Seu objetivo é construir corretamente o diagrama de tempo do sinal de saída do Flip-Flop. Para isso, analise cuidadosamente o comportamento dos sinais de entrada ao longo do tempo e movimente a personagem exatamente pelo caminho em que você deseja desenhar a linha do sinal de saída."/>
                        </ui:VisualElement>
                        <ui:VisualElement name="Moviment" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Use A/D ou as setas para esquerda/direita para movimentar horizontalmente a personagem. Ao andar para a direita, a linha do sinal de saída é desenhada. Ao andar para a esquerda, a linha é apagada (permitindo corrigir erros)."/>
                        </ui:VisualElement>
                        <ui:VisualElement name="VerticalMoviment" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Use W/S ou as setas para cima/baixo para alternar entre as plataformas do piso e do teto. Esse movimento é equivalente à trocar o valor lógico do sinal de saída entre 0 e 1."/>
                        </ui:VisualElement>
                        <ui:VisualElement name="Jump" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Use espaço para pular buracos nas plataformas ou desviar de outros obstáculos sem a necessidade de alternar plataformas."/>
                        </ui:VisualElement>
                        <ui:VisualElement name="Dash" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Use shift para correr por um breve instante de tempo e superar obstáculos mais desafiadores." />
                        </ui:VisualElement>
                        <ui:VisualElement name="Help" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Use H para habilitar/desabilitar as linhas de ajuda para eventos síncronos e assíncronos" />
                        </ui:VisualElement>
                        <ui:VisualElement name="EndOfLevel" class="tutorial-item">
                            <ui:VisualElement name="Image" class="image-slot"/>
                            <ui:Label name="Text" class="tutorial-text" text="Ao final da fase, verifique os acertos e erros no diagrama desenhado e a pontuação obtida." />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Voltar" name="BackButton" class="secondary-button hidden"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
